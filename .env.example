# API
VITE_BACKEND_URL=http://localhost:5005

# Google OAuth (get from https://console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# WebRTC ICE servers
# STUN — public address discovery (default: Google STUN)
VITE_STUN_URL=stun:stun.l.google.com:19302
# TURN — relay for users behind NAT/firewall (e.g. coturn or Metered/Twilio).
# Without TURN, media will NOT connect on many networks.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
